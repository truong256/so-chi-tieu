# Supabase Configuration
# Lấy từ: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local AI (Ollama) — Server-Side Only — không dùng NEXT_PUBLIC_
# Mặc định: http://127.0.0.1:11434
# Cài Ollama: https://ollama.ai
# Pull model: ollama pull llama3.2:3b (text/chat)
# Pull model: ollama pull llava:7b     (vision/receipt OCR)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local/FastAPI AI service (classification, forecast, risk, advisor)
AI_SERVICE_URL=http://127.0.0.1:8000

# Server-to-server authentication only.
# Generate a strong random secret.
# NEVER prefix with NEXT_PUBLIC_.
AI_INTERNAL_SERVICE_TOKEN=

# Internal telemetry endpoint authentication.
# May be separate from service token in production.
AI_INTERNAL_TELEMETRY_TOKEN=
