# Supabase Configuration
# Lấy từ: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini AI API Key (Server-Side Only — không dùng NEXT_PUBLIC_)
# Lấy từ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local/FastAPI AI service
AI_SERVICE_URL=http://127.0.0.1:8000

# Server-to-server authentication only.
# Generate a strong random secret.
# NEVER prefix with NEXT_PUBLIC_.
AI_INTERNAL_SERVICE_TOKEN=

# Internal telemetry endpoint authentication.
# May be separate from service token in production.
AI_INTERNAL_TELEMETRY_TOKEN=
