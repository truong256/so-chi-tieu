# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
tsconfig.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Note: /build/ is NOT ignored — it contains sites-vite-plugin.ts (source code)

# backups
backups/

# scratch
scratch/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/

# AI telemetry runtime logs (never commit real user events or feedback to git)
ai_service/data/real_events_telemetry.jsonl
ai_service/data/feedback_telemetry.jsonl
